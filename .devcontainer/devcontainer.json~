{
  "name": "My Journaling DevContainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu", 
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "installZsh": true
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y git-crypt",
  "customizations": {
    "vscode": {
      "extensions": [
        "yzane.markdown-pdf", 
        "shane.gpg-indicator"
      ]
    }
  }
}
